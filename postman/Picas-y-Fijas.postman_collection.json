                "exec": [
                  "pm.test(\"HTTP 200\", () => { if (pm.response.code !== 200) throw new Error(\"HTTP \" + pm.response.code + \": \" + pm.response.text()); });",
                  "const data = pm.response.json();",
                  "function check(ok, message) { pm.test(message, () => { if (!ok) throw new Error(message); }); }",
                  "check((pm.response.headers.get(\"Content-Type\") || \"\").includes(\"application/json\"), \"Respuesta JSON\");",
                  "check(data.status === \"in_progress\" && data.players.length === 2, \"Dos participantes en juego\");",
                  "check([\"postman_ana\",\"postman_luis\"].includes(data.turn), \"Turno inicial valido\");",
                  "const ana = data.turn === \"postman_ana\";",
                  "pm.collectionVariables.set(\"turnToken\", pm.collectionVariables.get(ana ? \"tokenAna\" : \"tokenLuis\"));",
                  "pm.collectionVariables.set(\"otherToken\", pm.collectionVariables.get(ana ? \"tokenLuis\" : \"tokenAna\"));",
                  "pm.collectionVariables.set(\"firstPlayer\", data.turn);",
                  "pm.collectionVariables.set(\"otherPlayer\", ana ? \"postman_luis\" : \"postman_ana\");",
                  "pm.collectionVariables.set(\"winningGuess\", ana ? \"0123\" : \"4271\");"
                ]
              }
            }
          ],
          "response": []
        },

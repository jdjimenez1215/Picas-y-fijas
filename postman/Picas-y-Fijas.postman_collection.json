            "description": "HTTP esperado: 200. Caso exitoso.",
            "body": {
              "mode": "raw",
              "raw": "{\"number\": \"{{winningGuess}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { if (pm.response.code !== 200) throw new Error(\"HTTP \" + pm.response.code + \": \" + pm.response.text()); });",
                  "const data = pm.response.json();",
                  "function check(ok, message) { pm.test(message, () => { if (!ok) throw new Error(message); }); }",
                  "check((pm.response.headers.get(\"Content-Type\") || \"\").includes(\"application/json\"), \"Respuesta JSON\");",
                  "check(data.fijas === 4 && data.picas === 0, \"Cuatro fijas y cero picas\");"
                ]
              }
            }
          ],
          "response": []
        }

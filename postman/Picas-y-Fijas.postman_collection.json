      "name": "01 - POST /login",
      "item": [
        {
          "name": "01 - Registrar postman_ana [200]",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "HTTP esperado: 200. Caso exitoso.",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"postman_ana\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { if (pm.response.code !== 200) throw new Error(\"HTTP \" + pm.response.code + \": \" + pm.response.text()); });",
                  "const data = pm.response.json();",
                  "function check(ok, message) { pm.test(message, () => { if (!ok) throw new Error(message); }); }",
                  "check((pm.response.headers.get(\"Content-Type\") || \"\").includes(\"application/json\"), \"Respuesta JSON\");",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"tokenAna\", data.token);",
                  "check(typeof data.token === \"string\" && data.token.length > 0, \"Token firmado recibido\");"
                ]
              }
            }
          ],
          "response": []
        },

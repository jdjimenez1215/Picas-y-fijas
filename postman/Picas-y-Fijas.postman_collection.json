                  "const ana = data.player === \"postman_ana\";",
                  "check(data.guess === \"8901\" && data.fijas === (ana ? 0 : 1) && data.picas === (ana ? 2 : 0), \"Picas y fijas correctas\");"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "15 - Victoria con cuatro fijas [200]",

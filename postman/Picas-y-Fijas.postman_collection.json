    {
      "name": "06 - GET /juego",
      "item": [
        {
          "name": "19 - Listar todos los estados y ganadores [200]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/juego",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAna}}"
              }
            ],
            "description": "HTTP esperado: 200. Caso exitoso."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => { if (pm.response.code !== 200) throw new Error(\"HTTP \" + pm.response.code + \": \" + pm.response.text()); });",
                  "const data = pm.response.json();",
                  "function check(ok, message) { pm.test(message, () => { if (!ok) throw new Error(message); }); }",
                  "check((pm.response.headers.get(\"Content-Type\") || \"\").includes(\"application/json\"), \"Respuesta JSON\");",
                  "check(Array.isArray(data), \"Lista de partidas\");",
                  "for (const [key,status] of [[\"waitingId\",\"waiting\"],[\"activeId\",\"in_progress\"],[\"gameId\",\"finished\"]]) {",
                  " const game = data.find(g => g.id === pm.collectionVariables.get(key));",
                  " check(!!game && game.status === status && game.creator === \"postman_ana\", \"Estado y creador: \" + status);",
                  " if (game && status === \"finished\") check(game.winner === pm.collectionVariables.get(\"firstPlayer\"), \"Ganador en listado\");",
                  "}",
                  "check(data.every(g => !(\"attempts\" in g) && !(\"turn\" in g) && !(\"secret\" in g) && !(\"_secrets\" in g)), \"Listado sin detalles privados\");"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
